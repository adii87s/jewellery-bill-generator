# PostgreSQL connection string.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://jewellery_user:changeme@localhost:5432/jewellery_bills

# Random long secret string, used for cookie signing / future token needs.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-64-char-hex-string

# Plaintext password used ONLY once, on first server startup, to create the
# single admin account (it is hashed with Argon2 and stored in the
# database; the plaintext is never stored). Remove or change this after
# the admin account has been created.
ADMIN_PASSWORD=changeme

# Exact origin (scheme + host + port, no trailing slash) the frontend is
# served from. Used for CORS. Example for local dev with a simple static
# server on port 5500:
FRONTEND_ORIGIN=http://localhost:5500

# Set to "false" only for plain-HTTP local development so the session
# cookie can be set without HTTPS. Always "true" in production.
COOKIE_SECURE=true

# Hours before a login session expires and the user must log in again.
SESSION_TTL_HOURS=12
